# ===========================================
# Bitbucket OAuth Configuration (Default)
# ===========================================
# Users will sign in with their Bitbucket accounts - no manual token creation needed!
# 
# Setup (one-time, by you as the app owner):
# 1. Go to your Bitbucket workspace settings
# 2. Navigate to "OAuth consumers" under "Apps and features"
# 3. Create OAuth consumer(s) with:
#    - Callback URL (Test): http://localhost:3001/api/auth/callback/bitbucket
#    - Callback URL (Prod): https://deployments.capay.com/api/auth/callback/bitbucket
#    - Permissions: 
#      * Account: Read
#      * Workspace membership: Read
#      * Projects: Read
#      * Repositories: Read, Write
#      * Pipelines: Read, Write
#      * Deployments: Read, Write
# 4. Copy the Key (Client ID) and Secret below
# Note: Create separate consumers for test and production, or use multiple callback URLs if supported

BITBUCKET_CLIENT_ID=your_bitbucket_oauth_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_oauth_client_secret

# NextAuth Configuration
# Set to your actual URL (test: http://localhost:3001, prod: https://deployments.capay.com)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# ===========================================
# Advanced: API Token Mode (Optional)
# ===========================================
# Only use this if you want to bypass user login and use a fixed API token
# Uncomment and set AUTH_METHOD=token to enable

# AUTH_METHOD=token
# BITBUCKET_API_TOKEN=your_app_password_or_access_token
# BITBUCKET_USERNAME=your_bitbucket_username
# BITBUCKET_WORKSPACE=your_workspace_slug
