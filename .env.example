# ===========================================
# Bitbucket OAuth Configuration
# ===========================================
# Bitbucket OAuth credentials are now configured via the web UI on first launch.
# When you first access the application, you'll be prompted to enter your:
# - Client ID
# - Client Secret
# 
# These credentials are stored securely in browser cookies.
# Visit the /help page for detailed instructions on creating OAuth credentials.
#
# Optional: You can still set these as environment variables if preferred
# (environment variables will be used as fallback if no credentials are configured via UI)

# BITBUCKET_CLIENT_ID=your_bitbucket_oauth_client_id
# BITBUCKET_CLIENT_SECRET=your_bitbucket_oauth_client_secret

# NextAuth Configuration
# Set to your actual URL (test: http://localhost:3000, prod: https://deployment-dashboard.hexagonprofile.com)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# ===========================================
# SEO Configuration
# ===========================================
# Base URL for your application (used for sitemap and metadata)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google Search Console verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# ===========================================
# Advanced: API Token Mode (Optional)
# ===========================================
# Only use this if you want to bypass user login and use a fixed API token
# Uncomment and set AUTH_METHOD=token to enable

# AUTH_METHOD=token
# BITBUCKET_API_TOKEN=your_app_password_or_access_token
# BITBUCKET_USERNAME=your_bitbucket_username
# BITBUCKET_WORKSPACE=your_workspace_slug
